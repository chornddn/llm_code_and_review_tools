#!/usr/bin/env python3
"""Read-only CLI for wiki.whamcloud.com (Confluence Server) for LLM agents.

Prints JSON to stdout. Authenticates with a personal access token (PAT)
from the macOS Keychain. The tool never prints the token, never takes it
as a command-line argument, and never sends it to another host.

Commands:
  wiki auth set|status|clear    manage the PAT (run by a human, not an agent)
  wiki get TARGET               page text; TARGET is an id, URL or SPACE:Title
  wiki search QUERY             text search (or --cql for raw CQL)
  wiki children TARGET          child pages
  wiki spaces                   list spaces
"""
import argparse
import getpass
import html.parser
import json
import os
import re
import stat
import subprocess
import sys
import urllib.error
import urllib.parse
import urllib.request

HOST = "wiki.whamcloud.com"
BASE = f"https://{HOST}"
SERVICE = HOST  # Keychain service name
ACCOUNT = getpass.getuser()
FILE_TOKEN = os.path.expanduser("~/.config/wiki-tool/token")  # non-macOS fallback
ENV_TOKEN = "WIKI_WHAMCLOUD_TOKEN"


def die(msg, code=1):
    print(json.dumps({"error": msg}), file=sys.stderr)
    sys.exit(code)


# ---- token handling -------------------------------------------------------

def get_token():
    """Return the PAT or None. Order: Keychain, env var, 0600 file."""
    if sys.platform == "darwin":
        r = subprocess.run(
            ["security", "find-generic-password", "-s", SERVICE, "-a", ACCOUNT, "-w"],
            capture_output=True, text=True)
        if r.returncode == 0 and r.stdout.strip():
            return r.stdout.strip()
    if os.environ.get(ENV_TOKEN):
        return os.environ[ENV_TOKEN].strip()
    try:
        st = os.stat(FILE_TOKEN)
        if st.st_mode & (stat.S_IRWXG | stat.S_IRWXO):
            die(f"{FILE_TOKEN} must be mode 0600")
        with open(FILE_TOKEN) as f:
            return f.read().strip() or None
    except FileNotFoundError:
        return None


def cmd_auth(args):
    if args.action == "set":
        if sys.platform == "darwin":
            # No -w value: `security` prompts on the tty, so the PAT never
            # appears in argv or shell history. -U updates an existing item.
            r = subprocess.run(["security", "add-generic-password", "-U",
                                "-s", SERVICE, "-a", ACCOUNT,
                                "-l", "wiki.whamcloud.com PAT", "-w"])
            if r.returncode:
                die("security failed to store the token")
        else:
            tok = getpass.getpass("PAT: ").strip()
            os.makedirs(os.path.dirname(FILE_TOKEN), mode=0o700, exist_ok=True)
            fd = os.open(FILE_TOKEN, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
            with os.fdopen(fd, "w") as f:
                f.write(tok)
        args.action = "status"
    if args.action == "status":
        if not get_token():
            die("no token stored")
        me = api("/rest/api/user/current")
        print(json.dumps({"authenticated": me.get("type") == "known",
                          "user": me.get("displayName")}))
    elif args.action == "clear":
        if sys.platform == "darwin":
            subprocess.run(["security", "delete-generic-password",
                            "-s", SERVICE, "-a", ACCOUNT], capture_output=True)
        elif os.path.exists(FILE_TOKEN):
            os.remove(FILE_TOKEN)
        print(json.dumps({"cleared": True}))


# ---- HTTP -----------------------------------------------------------------

class NoRedirect(urllib.request.HTTPRedirectHandler):
    """Refuse redirects so the Authorization header cannot leak elsewhere."""
    def redirect_request(self, *a, **kw):
        return None


_opener = urllib.request.build_opener(NoRedirect)


def api(path, **params):
    url = BASE + path
    if params:
        url += "?" + urllib.parse.urlencode({k: v for k, v in params.items() if v is not None})
    req = urllib.request.Request(url, headers={"Accept": "application/json",
                                          "User-Agent": "wiki-tool/1.0"})  # Cloudflare 403s the default urllib UA
    tok = get_token()
    if tok:
        req.add_header("Authorization", f"Bearer {tok}")
    try:
        with _opener.open(req, timeout=30) as r:
            return json.load(r)
    except urllib.error.HTTPError as e:
        die(f"HTTP {e.code} for {path}")
    except urllib.error.URLError as e:
        die(f"network error: {e.reason}")


# ---- target resolution ----------------------------------------------------

EXPAND = "body.storage,version,space,ancestors"


def resolve(target):
    """Return a page id for an id, URL or SPACE:Title."""
    if target.isdigit():
        return target
    if target.startswith("http"):
        u = urllib.parse.urlparse(target)
        if u.hostname != HOST:
            die(f"URL host must be {HOST}")
        q = urllib.parse.parse_qs(u.query)
        if "pageId" in q:
            return q["pageId"][0]
        m = re.match(r"/display/([^/]+)/(.+)", u.path)
        if m:
            return by_title(m[1], urllib.parse.unquote_plus(m[2]))
        m = re.match(r"/spaces/[^/]+/pages/(\d+)", u.path)
        if m:
            return m[1]
        die("unrecognised wiki URL")
    if ":" in target:
        space, title = target.split(":", 1)
        return by_title(space, title)
    die("TARGET must be a page id, wiki URL or SPACE:Title")


def by_title(space, title):
    res = api("/rest/api/content", spaceKey=space, title=title, limit=1)["results"]
    if not res:
        die(f"no page '{title}' in space {space}")
    return res[0]["id"]


# ---- HTML -> text ---------------------------------------------------------

class Text(html.parser.HTMLParser):
    BLOCK = {"p", "div", "br", "tr", "li", "h1", "h2", "h3", "h4", "h5", "h6", "pre", "table", "ul", "ol"}

    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.out = []

    def handle_starttag(self, tag, attrs):
        if tag in self.BLOCK:
            self.out.append("\n")
        if tag == "li":
            self.out.append("- ")
        elif tag[0] == "h" and tag[1:].isdigit():
            self.out.append("#" * int(tag[1:]) + " ")
        elif tag in ("td", "th"):
            self.out.append(" | ")

    def handle_endtag(self, tag):
        if tag in self.BLOCK:
            self.out.append("\n")

    def handle_data(self, data):
        self.out.append(data)


def to_text(storage):
    p = Text()
    p.feed(storage)
    return re.sub(r"\n{3,}", "\n\n", "".join(p.out)).strip()


# ---- commands -------------------------------------------------------------

def brief(r):
    return {"id": r["id"], "title": r["title"],
            "space": r.get("space", {}).get("key"),
            "url": BASE + r["_links"]["webui"]}


def cmd_get(args):
    p = api(f"/rest/api/content/{resolve(args.target)}", expand=EXPAND)
    body = p["body"]["storage"]["value"]
    if args.format == "text":
        body = to_text(body)
    truncated = args.max_chars and len(body) > args.max_chars
    if truncated:
        body = body[:args.max_chars]
    out = brief(p)
    out.update(version=p["version"]["number"], modified=p["version"]["when"],
               ancestors=[a["title"] for a in p.get("ancestors", [])],
               truncated=bool(truncated), body=body)
    print(json.dumps(out))


def cmd_search(args):
    if args.cql:
        cql = args.query
    else:
        cql = 'type = page AND siteSearch ~ "%s"' % args.query.replace('"', '\\"')
        if args.space:
            cql += f' AND space = "{args.space}"'
    res = api("/rest/api/content/search", cql=cql, limit=args.limit, expand="space")
    print(json.dumps([brief(r) for r in res["results"]]))


def cmd_children(args):
    res = api(f"/rest/api/content/{resolve(args.target)}/child/page", limit=args.limit, expand="space")
    print(json.dumps([brief(r) for r in res["results"]]))


def cmd_spaces(args):
    res = api("/rest/api/space", limit=args.limit)
    print(json.dumps([{"key": s["key"], "name": s["name"]} for s in res["results"]]))


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    sub = ap.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("auth"); s.add_argument("action", choices=["set", "status", "clear"])
    s.set_defaults(fn=cmd_auth)

    s = sub.add_parser("get"); s.add_argument("target")
    s.add_argument("--format", choices=["text", "storage"], default="text")
    s.add_argument("--max-chars", type=int, default=0, help="truncate body (0 = no limit)")
    s.set_defaults(fn=cmd_get)

    s = sub.add_parser("search"); s.add_argument("query")
    s.add_argument("--space"); s.add_argument("--cql", action="store_true", help="QUERY is raw CQL")
    s.add_argument("--limit", type=int, default=20); s.set_defaults(fn=cmd_search)

    s = sub.add_parser("children"); s.add_argument("target")
    s.add_argument("--limit", type=int, default=100); s.set_defaults(fn=cmd_children)

    s = sub.add_parser("spaces"); s.add_argument("--limit", type=int, default=100)
    s.set_defaults(fn=cmd_spaces)

    args = ap.parse_args()
    args.fn(args)


if __name__ == "__main__":
    main()
